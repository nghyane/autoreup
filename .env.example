# Copy to .env and fill in YOUR values. Nothing here is required to start the UI;
# the pipeline stages fail with a clear message when their piece is missing.
# Provider/model/voice/ASR values below only SEED the in-app settings: once you save
# ⚙ Cài đặt, .autoreup-private/settings.json overrides them — AGENT_PROVIDER/BIN/HOME/
# COMMAND/EFFORT, TRANSLATE_MODEL, POLISH_MODEL, ASR_BACKEND/WORKER_URL/MODEL/OCR_SUBS,
# TTS_ENABLED/NATIVE/SERVER_URL/VOICE/SYNTH_RATE, CAPCUT_EMAIL/PASSWORD. Later env edits
# of those have no effect; timeouts, retries, workers and paths stay env.

# --- App -------------------------------------------------------------------
AUTOREUP_APP_NAME="AutoReup"

# --- Dubbing agent (headless CLI, no API key) ------------------------------
# provider=agy  : Antigravity CLI (subscription OAuth)  -> agy -p ...
# provider=claude : Claude Code CLI (Claude Pro/Max login) -> claude -p ...
# provider=codex  : Codex CLI (ChatGPT login)              -> codex exec ...
# provider=command: any headless CLI, {prompt} placeholder
AUTOREUP_AGENT_PROVIDER="agy"
AUTOREUP_AGENT_BIN="agy"
# AUTOREUP_AGENT_HOME="~/.agy-accounts/acc2"          # isolate accounts (optional)
# AUTOREUP_AGENT_COMMAND="acpx claude exec --format quiet {prompt}"
AUTOREUP_TRANSLATE_MODEL="gemini-3.8-flash-low"
AUTOREUP_POLISH_MODEL="gemini-3.1-pro-high"
# AUTOREUP_TRANSLATE_TIMEOUT=1200                       # one workspace session
# AUTOREUP_TRANSLATE_RETRIES=2

# --- ASR --------------------------------------------------------------------
# auto = Qwen3-ASR (mlx-qwen3-asr) locally when installed, else mlx-whisper, else the
# Cloudflare worker. Explicit: qwen | local (mlx-whisper) | worker
AUTOREUP_ASR_BACKEND="auto"
# AUTOREUP_ASR_WORKER_URL="https://your-worker.example.workers.dev"   # backend=worker
# AUTOREUP_ASR_MODEL="@cf/openai/whisper-large-v3-turbo"

# --- Provider cookies (Douyin) ---------------------------------------------
# The UI stores cookies in .autoreup-private/cookies/ (never served).
# AUTOREUP_COOKIES_FILE="/absolute/path/to/cookies.txt"
# AUTOREUP_BROWSER_PATH="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"

# --- TTS (voice-over) -------------------------------------------------------
AUTOREUP_TTS_ENABLED="false"
# AUTOREUP_TTS_SERVER_URL="http://127.0.0.1:8080"       # HTTP provider
AUTOREUP_TTS_VOICE="BV421_vivn_streaming"
AUTOREUP_TTS_TEXT_MODE="expressive"
AUTOREUP_TTS_SYNTH_RATE="1.0"
# Other TTS engines (edge, openai_compat, gemini, elevenlabs) are chosen as a connection
# type in ⚙ Cài đặt, not via env — their keys/models live in settings.json.
# CapCut-style TTS with YOUR account (native mode, no external server):
# AUTOREUP_CAPCUT_EMAIL="you@example.com"
# AUTOREUP_CAPCUT_PASSWORD="..."

# --- Mix (original audio stays as a bed under the dub) ----------------------
# tts_crossfade, dub_bed_volume, dub_duck, dub_carve_db … see docs/SPEC.md §12
